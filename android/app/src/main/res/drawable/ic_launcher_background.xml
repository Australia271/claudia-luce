<?xml version="1.0" encoding="utf-8"?>
<!-- Icona "Blu e oro": sfondo con il blu dell'app, più chiaro in alto a sinistra.
     La sfumatura copre la parte visibile dell'icona adattiva (da 18 a 90). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0 L108,0 L108,108 L0,108 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="18"
                android:startY="18"
                android:endX="90"
                android:endY="90"
                android:startColor="@color/icon_blue_light"
                android:endColor="@color/icon_blue_dark" />
        </aapt:attr>
    </path>
</vector>
